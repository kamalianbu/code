with connect_report(
    report="Coms DB Landing Page (2)_clone_report",
    workspace=target_workspace
) as rpt:

    report_json = rpt.get("report.json")

    print("Searching entire report.json for:")
    print("  entities")
    print("  measures")
    print("  reportExtensions")
    print("  measure")
    print("=" * 60)

    def find_keys(obj, path="root"):

        if isinstance(obj, dict):

            for key, value in obj.items():

                key_lower = str(key).lower()

                if (
                    "entit" in key_lower
                    or "measure" in key_lower
                    or "reportextension" in key_lower
                ):
                    print("\nFOUND KEY")
                    print("Path :", path)
                    print("Key  :", key)
                    print("Type :", type(value))
                    print("Value:", str(value)[:1000])

                find_keys(value, f"{path}.{key}")

        elif isinstance(obj, list):

            for i, item in enumerate(obj):
                find_keys(item, f"{path}[{i}]")

    find_keys(report_json)
