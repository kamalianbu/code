def inspect_legacy_measure_locations(target_rpt_name, workspace):

    print(f"\nInspecting: {target_rpt_name}")

    with connect_report(
        report=target_rpt_name,
        workspace=workspace
    ) as rpt:

        report_json = rpt.get("report.json")

        print("report.json type:", type(report_json))

        if not isinstance(report_json, dict):
            print("ERROR: report.json is not a dictionary")
            return

        print("\nTop-level keys:")
        print(list(report_json.keys()))

        measure_hits = []

        def scan(obj, path="root"):

            if isinstance(obj, dict):

                # Direct Measure node
                if "Measure" in obj:
                    measure_hits.append({
                        "path": path,
                        "Measure": obj["Measure"]
                    })

                # Any property literally called measures
                if "measures" in obj:
                    measure_hits.append({
                        "path": path,
                        "measures": obj["measures"]
                    })

                for key, value in obj.items():
                    scan(value, f"{path}.{key}")

            elif isinstance(obj, list):

                for i, item in enumerate(obj):
                    scan(item, f"{path}[{i}]")

        scan(report_json)

        print("\n====================================")
        print("MEASURE LOCATIONS FOUND")
        print("====================================")

        print("Total measure hits:", len(measure_hits))

        for i, hit in enumerate(measure_hits[:50], 1):
            print(f"\n--- Measure hit {i} ---")
            print("Path:", hit["path"])

            if "Measure" in hit:
                print("Measure:", hit["Measure"])

            if "measures" in hit:
                print("measures:", hit["measures"])


inspect_legacy_measure_locations(
    "Coms DB Landing Page (2)_clone_report",
    target_workspace
)
