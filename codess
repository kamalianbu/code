Patch all report defintions

# Verify the discover step has populated the globals this cell depends on
if "measure_names" not in dir() or "old_to_new" not in dir():
    raise RuntimeError("Run the 'Discover current measures' cell before patching.")

workspace_id = fabric.resolve_workspace_id(target_workspace)
client = fabric.FabricRestClient()


# ── Patch all cloned reports ────────────────────────────────────────────────
# This is the driver loop that orchestrates the full patch sequence for every
# report in the active profile. For each report it: downloads the definition,
# detects the format (PBIR vs PBIR-Legacy), remaps measure references from
# old source tables to _Measures, and uploads the patched definition back.
# Reports that reference no measures are skipped entirely.

time.sleep(5)  # Allow clones to settle in the Fabric backend before querying, if we didn't have this then the clones may not be accessible / visible to the API

# Retrieve ALL reports in the workspace once, then filter to the ones this
# profile cares about. This avoids repeated API calls inside the loop.
all_reports = fabric.list_reports(workspace=target_workspace)
summary = []

for rpt_name in source_reports:
    target_rpt_name = f"{rpt_name}{report_suffix}"
    print(f"\n{'='*60}")
    print(f"{target_rpt_name}")
    print(f"{'='*60}")

    # Look up the cloned report by its expected name in the workspace listing
    report_row = all_reports[all_reports["Name"] == target_rpt_name]
    if report_row.empty:
        print(f"  Not found. Skipping.")
        summary.append({"Report": rpt_name, "Status": "Not found", "Measures Used": 0, "Refs Patched": 0})
        continue

    # Download the full report definition (async poll handled by get_report_definition)
    report_id = report_row["Id"].values[0]
    result = get_report_definition(report_id)
    parts = result["definition"]["parts"]

    # Quick text scan to see which measures this report actually references.
    # If none, there is nothing to remap and we skip the expensive patch step.
    measures_found = scan_measure_usage(parts)

    # Format detection: PBIR reports contain individual visual.json files per
    # visual; PBIR-Legacy stores everything in a single report.json. The two
    # formats require different patching strategies (patch_pbir vs patch_pbir_legacy).
    has_visual_files = any("visual.json" in p["path"] for p in parts)
    fmt = "PBIR" if has_visual_files else "PBIR-Legacy"

    print(f"  Format: {fmt}")
    print(f"  Measures referenced: {len(measures_found)}")

    if len(measures_found) == 0:
        print(f"  No measures used. Skipping patch.")
        summary.append({"Report": rpt_name, "Status": "No measures used", "Measures Used": 0, "Refs Patched": 0})
        continue

    # Apply the format-appropriate patch. Both functions mutate `parts` in place
    # and return before/after counts so we can report how many references changed.
    if has_visual_files:
        before, after, patched = patch_pbir(parts)
    else:
        before, after, patched = patch_pbir_legacy(parts)

    refs_patched = before - after
    print(f"  Patched: {before} -> {after} ({refs_patched} refs, {patched} files)")

    # Push the patched definition back to Fabric. The report will be temporarily
    # broken between this upload and the measure-move step completing, because
    # the definition now points to _Measures but the model has not moved them yet.
    if upload_report_definition(report_id, result["definition"]):
        print(f"  Upload: Succeeded")
        summary.append({"Report": rpt_name, "Status": "Patched", "Measures Used": len(measures_found), "Refs Patched": refs_patched})
    else:
        print(f"  Upload: Failed")
        summary.append({"Report": rpt_name, "Status": "Upload failed", "Measures Used": len(measures_found), "Refs Patched": 0})

print(f"\n\n{'='*60}")
print("REPORT PATCH SUMMARY")
print(f"{'='*60}\n")
df_summary = pd.DataFrame(summary)
display(df_summary)
# Reports are now pointing at _Measures which does not yet exist in the model.
# They will resolve correctly once the move-measures cell completes.
print(f"\nAll reports patched. Reports are temporarily broken until the 'Move Measures' step completes.")

